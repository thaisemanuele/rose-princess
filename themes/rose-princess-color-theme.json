  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#8e9c93",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keyword, storage and operator",
      "scope": [
        "keyword",
        "storage",
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#f0b85b"
      }
    },
    {
      "name": "Control flow and module keywords (import, export, return, if)",
      "scope": [
        "keyword.control",
        "keyword.control.import",
        "keyword.control.export",
        "keyword.control.from",
        "keyword.control.flow",
        "keyword.control.conditional",
        "keyword.control.loop"
      ],
      "settings": {
        "foreground": "#E8476B",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Language constant (true, false, null, undefined)",
      "scope": [
        "constant.language"
      ],
      "settings": {
        "foreground": "#f0b85b"
      }
    },
    {
      "name": "Template expression ${}",
      "scope": [
        "punctuation.definition.template-expression"
      ],
      "settings": {
        "foreground": "#f0b85b"
      }
    },
    {
      "name": "HTML and JSX tag",
      "scope": [
        "entity.name.tag",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#f0b85b"
      }
    },
    {
      "name": "Function and method",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function"
      ],
      "settings": {
        "foreground": "#f7c6cf"
      }
    },
    {
      "name": "Property key (JSON, object literal, CSS)",
      "scope": [
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#f7c6cf"
      }
    },
    {
      "name": "JSX and HTML attribute",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#f7c6cf",
        "fontStyle": "italic"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#9cc7ae"
      }
    },
    {
      "name": "Type, class and interface",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#f5dfc0",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Number",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#f5dfc0"
      }
    },
    {
      "name": "Rare accents: this, regex, escapes",
      "scope": [
        "variable.language",
        "string.regexp",
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#e8476b",
        "fontStyle": "italic"
      }
    }
  ],
  "semanticTokenColors": {
    "function": "#f7c6cf",
    "method": "#f7c6cf",
    "class": {
      "foreground": "#f5dfc0",
      "italic": true
    },
    "type": {
      "foreground": "#f5dfc0",
      "italic": true
    },
    "interface": {
      "foreground": "#f5dfc0",
      "italic": true
    },
    "typeParameter": {
      "foreground": "#f5dfc0",
      "italic": true
    },
    "enum": {
      "foreground": "#f5dfc0",
      "italic": true
    },
    "enumMember": {
      "foreground": "#e8476b",
      "italic": true
    },
    "property.declaration": "#e6dfe3",
    "parameter": {
      "italic": true
    },
    "property": "#e6dfe3"
  }
}
